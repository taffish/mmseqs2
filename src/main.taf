<shell>
# Expose a verified optional resource; never infer an analysis argument or choose a member.
taf_mmseqs2_fail() { printf >&2 'taf-mmseqs2: %s\n' "$1"; exit 64; }
taf_mmseqs2_root=
case "${TAFFISH_MMSEQS2_DB_AUTO_MOUNT-1}" in
    0|false|FALSE|no|NO|off|OFF) ;;
    1|true|TRUE|yes|YES|on|ON)
        if test "${TAFFISH_MMSEQS2_DB_PATH+x}" = x; then
            taf_mmseqs2_root=$TAFFISH_MMSEQS2_DB_PATH
            test -n "$taf_mmseqs2_root" || taf_mmseqs2_fail 'invalid/unprepared shared DB root: empty explicit path'
        else
            for taf_mmseqs2_path in "${HOME}/.local/share/taffish/databases/mmseqs2" /usr/local/share/taffish/databases/mmseqs2 /opt/taffish/databases/mmseqs2; do
                if test -e "$taf_mmseqs2_path" || test -L "$taf_mmseqs2_path"; then taf_mmseqs2_root=$taf_mmseqs2_path; break; fi
            done
        fi
        if test -n "$taf_mmseqs2_root"; then
            case "$taf_mmseqs2_root" in /*) ;; *) taf_mmseqs2_fail 'invalid/unprepared shared DB root: use an absolute path' ;; esac
            test -d "$taf_mmseqs2_root" || taf_mmseqs2_fail "invalid/unprepared shared DB root: $taf_mmseqs2_root"
            taf_mmseqs2_root=$(CDPATH= cd "$taf_mmseqs2_root" && pwd -P) || taf_mmseqs2_fail 'cannot resolve shared DB root'
            case "$taf_mmseqs2_root" in *:*|*,*) taf_mmseqs2_fail 'invalid/unprepared shared DB root: unsupported bind separator' ;; esac
            command -v python3 >/dev/null 2>&1 || taf_mmseqs2_fail 'auto-mount needs host Python 3; disable discovery for a verified manual bind'
            python3 -I -B "::*LOADDIR*::/mmseqs2_validation.py" "$taf_mmseqs2_root" || taf_mmseqs2_fail 'invalid/unprepared shared DB root: verify or repair; disable auto-mount for setup'
        fi ;;
    *) taf_mmseqs2_fail 'invalid TAFFISH_MMSEQS2_DB_AUTO_MOUNT; use 0 or 1' ;;
esac
taf_mmseqs2_mount() {
    if test -z "$taf_mmseqs2_root"; then printf -- '--env=TAFFISH_ENV=TAFFISH'
    elif test "$1" = apptainer; then printf -- '--bind=%s:/resources/mmseqs2:ro' "$taf_mmseqs2_root"
    else printf -- '--volume=%s:/resources/mmseqs2:ro' "$taf_mmseqs2_root"; fi
}
<taf-app:container:ghcr.io/taffish/mmseqs2:20-r1$@[docker: --user=$(id -u):$(id -g) "$(taf_mmseqs2_mount docker)"][podman: --userns=keep-id --user=$(id -u):$(id -g) "$(taf_mmseqs2_mount podman)"][apptainer: "$(taf_mmseqs2_mount apptainer)"]>
mmseqs ::*ARGV*::
